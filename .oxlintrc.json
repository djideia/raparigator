{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "react", "jsx-a11y", "nextjs", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.2.3"
    }
  },
  "rules": {
    "no-unassigned-vars": "error",
    "no-useless-assignment": "error",
    "preserve-caught-error": "error",

    // A regra so olha 2 niveis de profundidade por padrao e acusa botoes
    // que tem texto real, so que aninhado mais fundo. Subir para 5 evita
    // que a saida seja por aria-label, que sobrescreveria o nome
    // acessivel computado do conteudo e o empobreceria.
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 5 }],

    // Paridade com o eslint-config-next: eram error la e nao estao na
    // categoria `correctness` do oxlint, entao precisam ser explicitas.
    "react-hooks/rules-of-hooks": "error",
    "react/no-unescaped-entities": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-require-imports": "error",

    // Next.js usa o JSX runtime automatico
    "react/react-in-jsx-scope": "off"
  },
  // jsx-a11y/prefer-tag-over-role fica ligada em todo o projeto. Estes
  // arquivos sao as unicas excecoes: a tag nativa que a regra pede nao
  // atende ao caso, e o role usado e o padrao ARIA correto.
  //
  // Vale saber que o eslint-plugin-jsx-a11y nao inclui essa regra nem em
  // `recommended` nem em `strict` (e opt-in); o oxlint a classificou em
  // `correctness`, que e ligada por default. Por isso ela conflita com
  // no-static-element-interactions em alguns casos.
  "overrides": [
    {
      // role="dialog" + aria-modal em portal com animacao. O <dialog>
      // nativo exige showModal() imperativo, top layer e ::backdrop
      // proprio - trocar reescreve o sistema de modais.
      "files": [
        "apps/web/components/ui/modal.tsx",
        "apps/web/components/ui/info-hint.tsx",
        "apps/web/components/ui/share-profile-modal.tsx",
        "apps/web/components/screens/ad-details/photo-lightbox.tsx",
        "apps/web/components/screens/chat-screen.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Combobox custom que implementa o padrao WAI-ARIA (combobox +
      // listbox + option). A regra pede <select>/<option> nativos, o que
      // significa apagar o componente.
      "files": ["apps/web/components/ui/select.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Editor de descricao e um contentEditable com formatacao rica;
      // role="textbox" e o correto, <textarea> nao suporta bold/listas.
      "files": ["apps/web/components/screens/professional-dashboard/announcement-tab.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // O onMouseOut do canvas de borrao encerra um arrasto de desenho;
      // nao revela conteudo, que e o caso que a regra existe para cobrir.
      // Nao ha equivalente de teclado a acrescentar: um onBlur so
      // dispararia com tabIndex, e dar foco a um canvas que nao aceita
      // desenho por teclado criaria um tab stop inutil.
      "files": ["apps/web/components/ui/image-blur-modal.tsx"],
      "rules": {
        "jsx-a11y/mouse-events-have-key-events": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/next-env.d.ts",
    "**/drizzle/**",
    ".tmp-venv/**",
    ".agents/**",
    ".claude/**",
    ".cursor/**",
    ".superpowers/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ]
}
