{
  "name": "raparigator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:legacy": "npm run dev:legacy -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "start": "npm run start -w apps/web",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/web",
    "test:e2e:ui": "npm run test:e2e:ui -w apps/web",
    "test:e2e:report": "npm run test:e2e:report -w apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "share": "npm run share -w apps/web"
  },
  "devDependencies": {
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "nanoid": "3.3.18",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
